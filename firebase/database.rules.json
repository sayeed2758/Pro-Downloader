{
  "rules": {
    ".read": false,
    ".write": false,
    
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid || root.child('admins').hasChild(auth.uid)",
        ".write": "$uid === auth.uid"
      }
    },
    
    "supportedSites": {
      ".read": true,
      ".write": "root.child('admins').hasChild(auth.uid)"
    },
    
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".read": "$uid === auth.uid"
      }
    },
    
    "downloadHistory": {
      "$uid": {
        ".read": "$uid === auth.uid || root.child('admins').hasChild(auth.uid)",
        ".write": "$uid === auth.uid"
      }
    },
    
    "settings": {
      ".read": true,
      ".write": "root.child('admins').hasChild(auth.uid)"
    }
  }
}
