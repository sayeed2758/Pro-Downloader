{
  "rules": {
    ".read": false,
    ".write": false,

    "supportedSites": {
      ".read": true,
      "$siteId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },

    "premiumPlans": {
      ".read": true,
      "$planId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },

    "announcements": {
      ".read": true,
      "$announcementId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },

    "settings": {
      "public": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      },
      "private": {
        ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "premium": {
          ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
        }
      }
    },

    "downloadHistory": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "bookmarks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "favoriteSites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "watched": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "reports": {
      "$reportId": {
        ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".write": "auth != null"
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".write": false
      }
    }
  }
}
